{
  "name": "bacon_code",
  "version": "1.0.0",
  "description": "Plugin de chiffrement et déchiffrement utilisant le chiffre Bacon (bilitère)",
  "author": "MysterAI",
  "plugin_type": "python",
  "entry_point": "main.py",
  "dependencies": [],
  "categories": ["AlphabetsDecryption"],
  "brute_force": true,
  "enable_scoring": true,
  "accept_accents": false,
  "scoring_method": {
    "type": "lexical",
    "custom_weights": {
      "lexical": 0.8,
      "gps": 0.2
    }
  },
  "input_types": {
    "text": {
      "type": "string",
      "label": "Texte à traiter",
      "placeholder": "Entrez le texte à chiffrer ou déchiffrer..."
    },
    "mode": {
      "type": "select",
      "label": "Mode",
      "options": ["encode", "decode", "detect"],
      "default": "decode"
    },
    "variant": {
      "type": "select",
      "label": "Alphabet (24 ou 26 lettres)",
      "options": ["26", "24"],
      "default": "26"
    },
    "symbol_a": {
      "type": "string",
      "label": "Symbole pour A",
      "placeholder": "A",
      "default": "A"
    },
    "symbol_b": {
      "type": "string",
      "label": "Symbole pour B",
      "placeholder": "B",
      "default": "B"
    },
    "auto_detect_symbols": {
      "type": "checkbox",
      "label": "Détection automatique des symboles A/B",
      "default": true
    }
  },
  "output_types": {
    "text_output": {
      "type": "string",
      "label": "Texte transformé"
    }
  }
} 